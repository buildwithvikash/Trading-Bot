# Copy to .env for local dev, or set these as Railway service variables.
#
# Leave APP_USERNAME/APP_PASSWORD unset for local dev — the login screen is
# skipped entirely when neither is set (see webapp/auth.py).
APP_USERNAME=
APP_PASSWORD=

# Railway sets PORT automatically — leave unset locally and in Railway.
# PORT=8000

# Anthropic AI Integration
ANTHROPIC_BASE_URL=https://api.openapis.online/anthropic
ANTHROPIC_API_KEY=admin
ANTHROPIC_MODEL=claude-opus-4-7

